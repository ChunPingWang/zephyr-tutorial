/*
 * ESP32-DevKitC：直接使用板上的 BOOT 按鍵（接在 GPIO0，板上已有上拉，
 * 按下時拉到 GND → active-low），不需外接零件。
 * LED 與課程 01 相同，指到 GPIO2。
 */
/ {
	leds {
		compatible = "gpio-leds";
		board_led: led_0 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "Board LED (GPIO2)";
		};
	};

	buttons {
		compatible = "gpio-keys";
		boot_button: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BOOT button (GPIO0)";
		};
	};

	aliases {
		led0 = &board_led;
		sw0 = &boot_button;
	};
};
